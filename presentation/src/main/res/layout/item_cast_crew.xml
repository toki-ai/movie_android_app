<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable
            name="castCrew"
            type="com.example.domain.entity.CastCrew" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="150dp"
        android:layout_height="160dp"
        android:background="@drawable/item_cast_border">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="100dp"
            android:scaleType="fitCenter"
            android:layout_height="100dp"
            app:imageUrl="@{castCrew.getProfilePathUrl}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{castCrew.name}"
            android:textColor="@color/text_main"
            android:textSize="12dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/profile_image"
            app:layout_constraintStart_toStartOf="@id/profile_image"
            app:layout_constraintEnd_toEndOf="@id/profile_image" />

        <TextView
            android:id="@+id/job"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{castCrew.job != null ? View.VISIBLE : View.GONE}"
            android:text="@{castCrew.job}"
            android:textSize="10dp"
            android:textColor="@color/text_sub"
            app:layout_constraintTop_toBottomOf="@id/name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/character"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{castCrew.character != null ? View.VISIBLE : View.GONE}"
            android:text="@{castCrew.character}"
            android:textAlignment="center"
            android:textSize="10dp"
            android:textColor="@color/text_sub"
            app:layout_constraintTop_toBottomOf="@id/name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"  />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>